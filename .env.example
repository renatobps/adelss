APP_NAME="ADELSS Sistema Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Retenção de logs de notificação (dias) — usado por logs:purge-old
LOGS_RETENTION_DAYS=180

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adelss
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=""

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=""

# PDF - Emojis na Observação (false=remove emojis para PDF limpo, true=tenta manter)
PDF_EMOJI=false

# WhatsApp (Evolution GO) - Módulo Notificações
# Docs: https://docs.evolutionfoundation.com.br/evolution-go
# Swagger: {WHATSAPP_API_URL}/swagger/index.html
WHATSAPP_API_URL=https://evogo.arkcoredev.com
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=aDelss
# Opcional: UUID da instância (senão é resolvido por nome via GET /instance/all)
WHATSAPP_INSTANCE_ID=
WHATSAPP_NUMBER=
# Local: URL do Ultrahook (ex.: https://seu-alias-webhook.ultrahook.com)
# Produção: URL pública (ex.: https://adelss.com.br/webhook)
WHATSAPP_WEBHOOK_URL=

# Mercado Pago (checkout transparente)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=ADELSS
MP_CURRENCY=BRL
MP_NOTIFICATION_URL=
MP_SANDBOX=true
MP_TEST_PAYER_EMAIL=
MP_TEST_PAYER_DOCUMENT=

# Financeiro - Notificações WhatsApp
FINANCIAL_WHATSAPP_DIZIMO=true
FINANCIAL_WHATSAPP_DESPESA=true
FINANCIAL_WHATSAPP_DESPESA_VENCIMENTO=true
FINANCIAL_WHATSAPP_PDF_RECEIPT=true
FINANCIAL_DESPESA_LEMBRETE_DIAS=1

# Google Drive (módulo Mídia)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_ROOT_FOLDER=ADELSS

# Instagram Graph API (módulo Mídia)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
